# Session and Security
SESSION_SECRET=generate-a-strong-random-string-32-chars-minimum

# Admin Credentials (password is hashed with bcrypt, store the hash not plain text)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here
# To generate a hash: node scripts/generate-password-hash.js

# Database
POSTGRES_URL=postgresql://user:password@host:5432/art_garage

# Vercel Blob Storage (for image/video uploads)
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token

# API Configuration
VITE_API_URL=/api
NODE_ENV=production
